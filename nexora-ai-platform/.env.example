# Environment Configuration
STAGE=dev
AWS_DEFAULT_REGION=us-east-1

# LocalStack Configuration (for local development)
USE_LOCALSTACK=true
LOCALSTACK_ENDPOINT=http://localhost:4566

# AWS Services (will be set by CDK deployment)
USERS_TABLE=nexora-users-dev
TENANTS_TABLE=nexora-tenants-dev
CONTENT_REQUESTS_TABLE=nexora-content-requests-dev
GENERATED_CONTENT_TABLE=nexora-generated-content-dev
WORKFLOW_EXECUTIONS_TABLE=nexora-workflow-executions-dev
PUBLICATIONS_TABLE=nexora-publications-dev

# Storage
CONTENT_BUCKET=nexora-content-dev-123456789012
ANALYTICS_BUCKET=nexora-analytics-dev-123456789012

# OpenSearch
OPENSEARCH_ENDPOINT=https://your-opensearch-endpoint.us-east-1.aoss.amazonaws.com

# Redis (for local development)
REDIS_ENDPOINT=localhost
REDIS_PORT=6379

# Cognito (will be set by CDK deployment)
USER_POOL_ID=us-east-1_XXXXXXXXX
USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# AI Configuration
BEDROCK_REGION=us-east-1
DEFAULT_EMBEDDING_MODEL=amazon.titan-embed-text-v1
DEFAULT_TEXT_MODEL=anthropic.claude-3-sonnet-20240229-v1:0
MAX_TOKENS=4000
TEMPERATURE=0.7

# Rate Limiting
RATE_LIMIT_RPM=60
RATE_LIMIT_TPM=10000

# Content Generation
MAX_CONTENT_LENGTH=10000
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=200

# Publishing
WEBHOOK_TIMEOUT=30
MAX_RETRY_ATTEMPTS=3

# Analytics
ANALYTICS_BATCH_SIZE=100
METRICS_RETENTION_DAYS=90

# Security (generate secure keys for production)
JWT_SECRET_KEY=your-jwt-secret-key-here
ENCRYPTION_KEY=your-encryption-key-here

# Logging
LOG_LEVEL=INFO
ENABLE_DEBUG=true

# Feature Flags
ENABLE_RESPONSIBLE_AI=true
ENABLE_ANALYTICS=true
ENABLE_CACHING=true

# LocalStack Pro (if you have a license)
# LOCALSTACK_API_KEY=your-localstack-api-key